# === LLM Configuration ===
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# === Database ===
DATABASE_URL=sqlite:///data/facts.db
EXTRACTION_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# === LLM Cost/Latency Controls ===
MAX_LLM_REQUESTS_PER_DOCUMENT=50
MAX_CONCURRENT_LLM_REQUESTS=5
EXTRACTION_BATCH_SIZE=10
MAX_CONTEXT_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_RETRY_MAX=3
LLM_RETRY_BACKOFF_SECONDS=2

# === Processing Limits ===
MAX_UPLOAD_MB=100
MAX_PAGES=500
MAX_PROCESSING_SECONDS=600
WORKER_CONCURRENCY=4
OCR_CONCURRENCY=2
EMBEDDING_CONCURRENCY=3

# === Comparison Tolerances ===
NUMERIC_TOLERANCE_EQUIVALENT=0.005
NUMERIC_TOLERANCE_ROUNDING=0.05
NUMERIC_TOLERANCE_CONTRADICTION=0.05

# === Pipeline Versioning ===
PIPELINE_VERSION=v1.0.0
EXTRACTOR_VERSION=v1.0.0
NORMALIZER_VERSION=v1.0.0
PROMPT_VERSION=2026-09-07

# === Security ===
UPLOAD_DIR=./uploads
PROCESSING_DIR=./processing
ALLOWED_MIME_TYPES=application/pdf

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
